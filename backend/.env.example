# ─── SpecGuard AI — Environment Variables Template ────────────────────────────
# Copy to backend/.env and fill in your values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=SpecGuard AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Database (PostgreSQL via asyncpg) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aitester:password@localhost:5432/aitester

# ─── Cache (Redis) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret-at-least-64-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Provider ─────────────────────────────────────────────────────────────
# "auto" = use Gemini if key is set, else Ollama (local, free)
AI_PROVIDER=auto

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local LLM, free for dev — run: ollama pull llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM usage monitoring
LLM_USAGE_LOG_ENABLED=true

# ─── Test Execution ──────────────────────────────────────────────────────────
MAX_CONCURRENT_TESTS=50
REQUEST_TIMEOUT_SECONDS=30.0

# ─── Reports ─────────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports

# ─── Celery Workers ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-generate-a-real-secret-key-at-least-32-chars
API_KEY_HEADER=X-API-Key
API_KEY=

# ─── Plan Limits ─────────────────────────────────────────────────────────────
FREE_PLAN_MONTHLY_RUNS=10
FREE_PLAN_MAX_ENDPOINTS=20
PRO_PLAN_MONTHLY_RUNS=500
